{
  "rules": {
    "toi_invites": {
      "$id": {
        ".read": true,
        ".write": "!data.exists() && newData.child('ch').isString() && !root.child('toi_used_codes').child(newData.child('ch').val()).exists() && newData.parent().parent().child('toi_used_codes').child(newData.child('ch').val()).child('id').val() === $id"
      }
    },
    "toi_used_codes": {
      "$hash": {
        ".read": true,
        ".write": "!data.exists() && newData.hasChildren(['t','id'])"
      }
    },
    "toi_montage": {
      ".read": true,
      ".write": true
    }
  }
}